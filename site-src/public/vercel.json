{
  "rewrites": [
    { "source": "/api/imtheo/roblox/version", "destination": "https://offsets.imtheo.lol/roblox/version" },
    { "source": "/api/imtheo/offsets.json", "destination": "https://offsets.imtheo.lol/offsets.json" },
    { "source": "/api/imtheo/FFlags.hpp", "destination": "https://offsets.imtheo.lol/FFlags.hpp" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
